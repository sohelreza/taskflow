# Server port — defaults to 4000 if not set
PORT=4000

# GitHub OAuth App credentials (register at GitHub Settings → Developer settings → OAuth Apps)
# Dev callback URL: http://localhost:4000/auth/callback
GITHUB_OAUTH_CLIENT_ID=your_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_client_secret_here

# Signed cookie secret — generate a 32+ character hex string:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=your_random_32_char_hex_string

# URL the client runs at — used for CORS and OAuth redirects
FRONTEND_URL=http://localhost:5173

# URL this server runs at — used for OAuth callback URL construction
BASE_URL=http://localhost:4000